{
  "name": "cairn",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean",
    "desktop:build:prod": "pnpm --filter @cairn/web tauri:build:prod",
    "desktop:build:dev": "pnpm --filter @cairn/web tauri:build:dev"
  },
  "devDependencies": {
    "canvas": "^3.2.3",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
