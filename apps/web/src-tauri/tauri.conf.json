{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn",
  "version": "0.1.0",
  "identifier": "com.cairn.app",
  "build": {
    "frontendDist": "https://oss-cairn.com",
    "devUrl": "https://develop.oss-cairn.com"
  },
  "app": {
    "windows": [
      {
        "title": "Cairn",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' https://oss-cairn.com https://develop.oss-cairn.com; script-src 'self' 'unsafe-inline' https://oss-cairn.com https://develop.oss-cairn.com; style-src 'self' 'unsafe-inline'; connect-src *; img-src * data: blob:; font-src * data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
