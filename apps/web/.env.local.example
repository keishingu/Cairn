# ローカル開発用環境変数 (supabase start 実行後にそのまま使える)
# コピー: cp apps/web/.env.local.example apps/web/.env.local

# Supabase Local (supabase start で自動起動)
# 本番を使う場合は NEXT_PUBLIC_SUPABASE_URL と NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY を本番の値に変更する
# ⚠️  Expo 実機 (WebView) から使う場合は 127.0.0.1 → Mac の LAN IP に変更する
#     例: NEXT_PUBLIC_SUPABASE_URL=http://192.168.1.97:54321
#     WebView 内 JS は端末上で実行されるため 127.0.0.1 は端末自身を指してしまう
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqFAn0sMmxMBoSGKa7vDdZ1JHcSLRMrAM
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0
# Inngest などサーバー専用コンテキスト向け（NEXT_PUBLIC_ が使えない場合のフォールバック）
# Vercel 本番環境では NEXT_PUBLIC_SUPABASE_URL と同じ値を設定する
SUPABASE_URL=http://127.0.0.1:54321

# Database (supabase start で自動起動)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# OpenAI (実際のキーを設定する)
OPENAI_API_KEY=your-openai-api-key

# PostHog (production 限定。ローカル・Preview では設定しない)
# Project token は PostHog の Project settings から取得し、Vercel Production のみに設定する
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps Platform (場所検索・カバー写真取得に使用)
# 取得先: https://console.cloud.google.com/
# 有効にする API: Places API (New)
GOOGLE_MAPS_API_KEY=

# Google カレンダー連携 (省略可 — 設定しない場合は Google カレンダー読み込み機能が無効)
# 取得先: https://console.cloud.google.com/ → OAuth 2.0 クライアント ID
# 有効にする API: Google Calendar API
# 承認済みリダイレクト URI に追加: http://localhost:3000/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Google カレンダートークン暗号化キー (省略可 — GOOGLE_CALENDAR_CLIENT_ID を設定する場合は必須)
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=

# Tavily (ウェブ検索機能。省略可 — 設定しない場合はウェブ検索なしで動作)
# 取得先: https://tavily.com
TAVILY_API_KEY=

# Inngest (ローカル開発では省略可)
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local

# Stripe 課金（未設定ならセルフホストとして課金機構を無効化）
# Stripe Dashboard で作成するSolo / Teamの月額Priceと、単発クレジットパックのPrice IDを指定する
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INDIVIDUAL_PRICE_ID=
STRIPE_WORKSPACE_PRICE_ID=
STRIPE_CREDIT_PACK_PRICE_ID=
# 本番の正規URL。未設定時は、Checkoutを開始したリクエストのURLを利用する
APP_URL=http://localhost:3128

# Web Push / VAPID (省略可 — 設定しない場合はプッシュ通知なしで動作)
# 生成: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com
