{
  "name": "@cairn/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "build:internal:android": "eas build --platform android --profile preview",
    "build:internal:ios": "eas build --platform ios --profile preview",
    "build:production:ios": "eas build --platform ios --profile production",
    "device:register:ios": "eas device:create",
    "ios": "expo run:ios",
    "release:testflight:ios": "eas build --platform ios --profile production --auto-submit",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:ios:latest": "eas submit --platform ios --profile production --latest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7",
    "@cairn/shared": "workspace:*",
    "@expo/metro-runtime": "~55.0.12",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@supabase/supabase-js": "2.105.0",
    "@tanstack/react-query": "^5",
    "expo": "~55.0.0",
    "expo-apple-authentication": "~55.0.17",
    "expo-application": "~55.0.19",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-network": "~55.0.18",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-markdown-display": "7.0.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@cairn/config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
