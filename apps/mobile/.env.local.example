# EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_API_BASE_URL は通常設定不要。
# 未設定なら Metro の接続先ホスト（開発マシン）から自動導出されるため、
# シミュレータ・実機・Android エミュレータのいずれでも IP の書き換えなしで繋がる（lib/env.ts 参照）。
# 検証環境など固定 URL に向けたい場合のみコメントを外して指定する。
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3128
EXPO_PUBLIC_SUPABASE_ANON_KEY=（supabase start の出力値）
EXPO_PUBLIC_EAS_PROJECT_ID=
