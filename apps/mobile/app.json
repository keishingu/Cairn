{
  "expo": {
    "name": "Cairn",
    "slug": "cairn",
    "scheme": "cairn",
    "version": "1.1.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "platforms": ["ios", "android"],
    "ios": {
      "icon": "./assets/icon-ios.png",
      "bundleIdentifier": "com.oss-cairn",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "プロジェクトのメンションやタスクの更新を通知します",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oss_cairn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1622"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "チャットに添付する画像を選択するため、写真へのアクセスを使用します"
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3B82F6"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46195650-8dc8-4c73-9b32-c1b5134c0326"
      }
    },
    "owner": "keishingu",
    "runtimeVersion": "1.5.0",
    "updates": {
      "url": "https://u.expo.dev/46195650-8dc8-4c73-9b32-c1b5134c0326"
    }
  }
}
