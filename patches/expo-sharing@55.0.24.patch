+    // The display name comes from the sharing app, so it must not choose where the copy is written.
+    // Each file gets its own directory so that same-named files in one share do not overwrite each other.
+    private fun incomingCacheFile(cacheDir: File, displayName: String): File {
+      val name = File(displayName).name
+      if (name.isEmpty() || name == "." || name == "..") {
+        throw IllegalArgumentException("Invalid shared file name: $displayName")
+      }
+      val directory = File(File(cacheDir, "expo-sharing"), UUID.randomUUID().toString())
+      val file = File(directory, name)
+      if (!file.canonicalPath.startsWith(cacheDir.canonicalPath + File.separator)) {
+        throw IllegalArgumentException("Shared file escapes the cache directory: $displayName")
+      }
+      if (!directory.mkdirs()) {
+        throw IllegalStateException("Could not create a directory for the shared file")
+      }
+      return file
+    }
